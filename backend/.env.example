APP_NAME=MedVision AI
APP_VERSION=1.0.0

# PostgreSQL connection used by SQLAlchemy and Alembic.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Generate a long random value for production; never commit the real value.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SQLALCHEMY_ECHO=false

# Set this to the deployed Vercel origin in production.
FRONTEND_URL=https://your-vercel-project.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used only by the admin seed script.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-deployment-secret

# Optional persistent storage mount paths. Defaults are backend/uploads and backend/reports.
UPLOAD_DIR=
REPORTS_DIR=
